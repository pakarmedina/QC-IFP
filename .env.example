# Neon: gunakan connection string "pooled" untuk DATABASE_URL, "direct" untuk DIRECT_URL (migrasi)
DATABASE_URL="postgresql://user:password@host/qc_ifp?sslmode=require"
DIRECT_URL="postgresql://user:password@host/qc_ifp?sslmode=require"

# URL publik aplikasi (dipakai untuk tautan reset kata sandi dan cek origin)
APP_URL="http://localhost:3000"

# Admin pertama, dibuat oleh `npm run db:seed` (ganti kata sandinya setelah login)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# SMTP untuk email reset kata sandi (kosongkan saat lokal: tautan dicetak di log server)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QC IFP <no-reply@example.com>"

# Cloudflare R2 (dipakai pada tahap unggah foto)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
